# Copia a .env.local para probar en tu PC. En Vercel se definen en Settings > Environment Variables.
# Credenciales OAuth de Google Cloud (tipo "Aplicación web")
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Clave para firmar la sesión (mínimo 32 caracteres, aleatoria):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Solo para pruebas: 1 = ignora la API y usa data/dolar-respaldo.json
FORZAR_DOLAR_RESPALDO=
